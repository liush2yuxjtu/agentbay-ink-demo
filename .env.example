# CLIProxyAPI 由 scripts/with-runtime.sh 从 ~/.config/claudex 安全注入，通常无需配置。
# AgentBay 二选一：环境变量，或把密钥仅写入 ~/.config/agentbay/api_key（推荐）。
AGENTBAY_API_KEY=

# 默认 10 分钟无活动销毁；测试时可缩短。预览激活后改用固定 60 分钟 TTL。
AGENTBAY_IDLE_MS=600000
AGENTBAY_PREVIEW_TTL_MS=3600000

# Claude JSONL 外部归档目录；/tmp 仅用于 Demo，生产请换成持久卷或对象存储适配器。
AGENTBAY_SESSION_DIR=/tmp/agentbay-demo-sessions

# Basic 默认允许 10 个并行会话；套餐变化后只需改这里。
AGENTBAY_PARALLEL_LIMIT=10

# 上方面板按官方费率估算 RUNNING 燃烧率；底部 BSS 状态只显示已入账 PayAsYouGo 消费。
AGENTBAY_CPU_CNY_PER_CORE_HOUR=0.12
# 官方同页计费示例使用 0.20；在文档口径统一前，TUI 用两者显示估算区间。
AGENTBAY_CPU_CNY_PER_CORE_HOUR_HIGH=0.20
AGENTBAY_MEMORY_CNY_PER_GIB_HOUR=0.05

# /bill 使用本机 aliyun CLI 当前 profile 读取已入账按量消费；需要指定时设置 ALIYUN_PROFILE。
ALIYUN_PROFILE=
AGENTBAY_BILL_DIR=/tmp

# LAN Web：默认自动绑定当前机器的私有 LAN IPv4；无登录，仅限可信局域网。
# 如需覆盖绑定地址再设置 AGENTBAY_WEB_HOST；不要把 8787 暴露到公网。
AGENTBAY_WEB_HOST=
AGENTBAY_WEB_PORT=8787
